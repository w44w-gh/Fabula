# これを functions/.env にコピーして実値を入れる（.env は git 管理外）
# ↓ 秘密ではない設定値（Discord Developer Portal / サーバーで取得）
DISCORD_CLIENT_ID=あなたのDiscordアプリのClient ID
DISCORD_GUILD_ID=対象サーバー(ギルド)のID
DISCORD_SUPPORTER_ROLE_ID=支援者ロールのID

# ↓ 秘密情報は .env に書かず、シークレットで登録すること:
#   firebase functions:secrets:set DISCORD_CLIENT_SECRET
#   firebase functions:secrets:set DISCORD_BOT_TOKEN
