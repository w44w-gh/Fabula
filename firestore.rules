rules_version = '2';
// Fabula:
//  - users/{uid}/...      各ユーザーの非共有(private)作品。本人のみ読み書き可。
//  - works/{workId}/...   共有(shared)作品。ライブ共同編集＋共有リンク参加。
service cloud.firestore {
  match /databases/{database}/documents {

    // 非共有作品：本人のみ
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 共有作品
    match /works/{workId} {
      // 読み取り：ログイン済みなら可（unguessable な workId＝共有リンクが能力。"リンクを知る人は閲覧可"モデル）
      allow read: if request.auth != null;

      // 作成：作成者が自分を owner かつ member に設定している場合のみ
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.auth.uid in request.resource.data.members;

      // 本文編集：member による更新。owner は奪えない（ownerUid 不変）
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.members
                    && request.resource.data.ownerUid == resource.data.ownerUid;

      // リンク参加：members のみ変更・自分だけ追加・他者を消さない・参加受付中(inviteOpen)
      allow update: if request.auth != null
                    && resource.data.inviteOpen == true
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
                    && request.resource.data.members.toSet().difference(resource.data.members.toSet()) == [request.auth.uid].toSet()
                    && resource.data.members.toSet().difference(request.resource.data.members.toSet()).size() == 0;

      // 削除：owner のみ
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;

      // 章：読みはログイン済み可／書きは member のみ
      match /chapters/{chId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/works/$(workId)).data.members;
      }

      // presence（誰が編集中）：読みはログイン済み可／書きは自分の doc かつ member のみ
      match /presence/{puid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == puid
          && request.auth.uid in get(/databases/$(database)/documents/works/$(workId)).data.members;
      }
    }
  }
}
